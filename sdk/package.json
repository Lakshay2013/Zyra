{
  "name": "zyra-sdk",
  "version": "0.2.0",
  "description": "Official Zyra SDK — AI cost optimizer proxy client. Drop-in replacement for the OpenAI SDK. Auto-logs all LLM calls to Zyra.",
  "main": "src/index.js",
  "types": "src/index.d.ts",
  "bin": {
    "zyra": "./bin/zyra"
  },
  "exports": {
    ".": "./src/index.js",
    "./auto": "./src/auto.js",
    "./logger": "./src/logger.js"
  },
  "scripts": {
    "test": "node --test tests/",
    "test:log": "node tests/log-dispatch.test.js",
    "test:proxy": "node tests/proxy-passthrough.test.js",
    "test:auto": "node tests/auto-patch.test.js"
  },
  "keywords": [
    "zyra",
    "ai",
    "llm",
    "cost-optimization",
    "proxy",
    "openai",
    "anthropic",
    "routing",
    "observability"
  ],
  "license": "MIT",
  "dependencies": {
    "openai": "^6.33.0"
  }
}
