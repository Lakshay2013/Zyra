{
  "name": "zyra-backend",
  "version": "0.1.0-beta",
  "description": "Zyra AI cost optimization proxy — backend API server",
  "author": "Zyra Team",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "start:prod": "NODE_ENV=production node src/index.js",
    "dev": "nodemon src/index.js",
    "worker": "nodemon src/workers/index.js",
    "seed:dev": "node scripts/seed-dev.js",
    "test": "node --test --test-force-exit --test-concurrency=1 \"tests/unit/**/*.test.js\" \"tests/integration/**/*.test.js\"",
    "test:unit": "node --test --test-force-exit \"tests/unit/**/*.test.js\"",
    "test:integration": "node --test --test-force-exit --test-concurrency=1 \"tests/integration/**/*.test.js\"",
    "test:providers": "node scripts/provider-smoke.js"
  },
  "keywords": [
    "zyra",
    "ai",
    "proxy",
    "cost-optimization",
    "llm"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "axios": "^1.13.6",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.70.1",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "express-validator": "^7.3.1",
    "google-auth-library": "^10.6.2",
    "helmet": "^8.1.0",
    "http-proxy-middleware": "^3.0.5",
    "ioredis": "^5.9.3",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.2.1",
    "morgan": "^1.10.1",
    "node-fetch": "^3.3.2",
    "nodemailer": "^8.0.3",
    "rate-limit-redis": "^4.3.1",
    "razorpay": "^2.9.6"
  },
  "devDependencies": {
    "mongodb-memory-server": "^10.4.3",
    "nock": "^13.5.6",
    "nodemon": "^3.1.14",
    "supertest": "^7.2.2"
  }
}
