# ─────────────────────────────────────────────────────────────
# Zyra backend — production environment
# Copy to backend/.env and fill in real values. Never commit the filled file.
# ─────────────────────────────────────────────────────────────

# ── Required (the API will NOT start without these) ──
NODE_ENV=production
PORT=5000

# MongoDB — Atlas connection string in production
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/zyra?retryWrites=true&w=majority

# JWT signing secret — node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=GENERATE_A_STRONG_SECRET_HERE

# Encryption key for provider API keys at rest — must be 64 hex chars (32 bytes)
#   openssl rand -hex 32
ENCRYPTION_KEY=GENERATE_A_64_CHAR_HEX_STRING_HERE

# ── Redis (rate limiting, response cache, idempotency, BullMQ) ──
# Managed Redis: set REDIS_PASSWORD to use the rediss:// TLS URL form.
REDIS_HOST=your-redis-host
REDIS_PORT=6379
# REDIS_PASSWORD=your-redis-password

# ── Server config ──
JWT_EXPIRES_IN=7d
# Comma-separated list of allowed frontend origins (CORS)
FRONTEND_URL=https://your-app.vercel.app
# Port the BullMQ worker process exposes its /health endpoint on
WORKER_HEALTH_PORT=5001

# ── Google OAuth (optional — "Sign in with Google" is disabled without it) ──
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ── SMTP (required in production — used for signup OTP emails) ──
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASS=your-smtp-app-password

# ── Razorpay (required only if you sell paid plans; billing endpoints
#    return 503 "billing not configured" when these are absent) ──
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret

# ── Optional ──
# Kill switch for the /v1/log ingest endpoint
# ZYRA_DISABLE=false
